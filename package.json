{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "type": "module",
  "homepage": "https://github.com/zerogravit1/forge#readme",
  "bugs": {
    "url": "https://github.com/zerogravit1/forge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerogravit1/forge.git"
  },
  "license": "Apache-2.0",
  "author": "Jonathan Schaffer",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "rm -rf dist/ && npm run typecheck && npm run lint && npm run test && npm run format:check && npm run build"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
